# .env.example — Week 1 / Day 4
# Copy to `.env` and adjust. NEVER commit your real `.env` (add it to .gitignore).
# In these labs the "secret" is just a local-dev value; the point is the HABIT of
# reading it from the environment instead of hardcoding it in code.

# Token the local practice API (lab_api.py) expects.
LAB_API_KEY=local-dev-key

# The client reads its bearer token from API_KEY.
API_KEY=local-dev-key

# Base URL of the local API (the notebooks set their own port: 8001 / 8002).
DATA_API_BASE_URL=http://127.0.0.1:8000
